# ==============================================================================
# GitHub Linguist — Classify this repository as a KiCad PCB project
# ==============================================================================

# Count KiCad PCB layout and schematic source files in GitHub language statistics
# (By default, GitHub Linguist classifies KiCad formats as `data` and hides them
# from the repository language bar, leaving only HTML/Python helper files.)
*.kicad_pcb       linguist-detectable=true
*.kicad_sch       linguist-detectable=true
*.kicad_wks       linguist-detectable=true

# Mark third-party vendor library downloads (symbols, footprints, ImportGuide.html,
# readme.txt) as vendored so vendor HTML/text files do not skew language stats
libs_*/**         linguist-vendored
*.html            linguist-vendored

# Exclude helper simulation scripts, batch/PowerShell wrappers, and docs from
# the primary repository language statistics bar
sim/**            linguist-detectable=false
*.py              linguist-detectable=false
*.ps1             linguist-detectable=false
*.bat             linguist-detectable=false
docs/**           linguist-documentation

# ==============================================================================
# Line Endings & Binary File Handling (Cross-Platform KiCad Best Practices)
# ==============================================================================

* text=auto

# Keep KiCad S-expression and JSON project files on consistent LF line endings
# to prevent noisy diffs across Windows, macOS, and Linux
*.kicad_pcb       text eol=lf
*.kicad_sch       text eol=lf
*.kicad_pro       text eol=lf
*.kicad_sym       text eol=lf
*.kicad_mod       text eol=lf
*.kicad_dru       text eol=lf
*.kicad_wks       text eol=lf
fp-lib-table      text eol=lf
sym-lib-table     text eol=lf

# Windows batch/PowerShell scripts
*.bat             text eol=crlf
*.ps1             text eol=crlf

# Binary assets (renders, schematics/BOM PDFs, 3D STEP/VRML models, gerber zips)
*.png             binary
*.jpg             binary
*.jpeg            binary
*.pdf             binary
*.step            binary
*.stp             binary
*.wrl             binary
*.zip             binary
